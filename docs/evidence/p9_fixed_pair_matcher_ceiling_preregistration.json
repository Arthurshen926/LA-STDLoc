      "at_least_one_primary_strict_gain": "correct_count or verified_triangle_count or cycle_supported_edge_count variant > control"
    },
    "metric_definitions": {
      "raw_match_count": "sum per fixed pair of reciprocal MNN rows or compact post-internal-filter LighterGlue rows before common epipolar filtering",
      "epipolar_accepted_count": "count raw rows with finite symmetric_epipolar_error_px<=2.0",
      "epipolar_acceptance_rate": "epipolar_accepted_count/raw_match_count;defined_as_0.0_when_raw_match_count_is_0",
      "teacher_evaluable_count": "epipolar-accepted rows whose two rounded endpoints are in-bounds, valid-mask true, alpha>=0.2, finite positive depth, and whose two cross-camera projected depths are positive with finite errors",
      "correct_correspondence_count": "teacher-evaluable epipolar-accepted rows with maximum bidirectional depth reprojection error<=2.0",
      "correct_correspondence_precision": "correct_correspondence_count/teacher_evaluable_count;defined_as_0.0_when_teacher_evaluable_count_is_0",
      "verified_keypoint_triangle_count": "enumerate lexicographically sorted camera triples whose three undirected pairs exist; close exact row identities left_to_middle,left_to_right,middle_to_right; batch homogeneous DLT SVD from all three physical native_xy+0.5 observations; require finite homogeneous division, positive depth in all cameras, and maximum three-view reprojection error<=2.0;count every verified row closure",
      "cycle_supported_edge_count": "cardinality_of_unique_(fixed_pair_table_index,source_row,target_row)_tuples_participating_in_at_least_one_verified_keypoint_triangle",
      "verified_triangle_camera_indices": "sorted_unique_camera_indices_participating_in_at_least_one_verified_keypoint_triangle",
      "nonempty_pair_coverage_count": "number_of_fixed_pairs_with_at_least_one_epipolar_accepted_match",
      "identity_conflict_count": "after_processing_fixed_pairs_in_table_order_and_matches_in_source_row_order_union_all_epipolar_accepted_(camera,row)_nodes;for_each_connected_component_and_camera_add_max(number_of_distinct_rows_from_that_camera-1,0);sum_over_all_components",
      "identity_conflict_component_count": "number_of_union_components_with_identity_conflict_count_greater_than_zero"
    },
    "metric_pipeline_order": [
      "raw_matcher_output",
      "common_symmetric_epipolar_filter",
      "dense_depth_teacher_correctness",
      "exact_triangle_and_cycle_deduplication",
      "nonempty_pair_coverage",
      "identity_conflict_union"
    ],
    "verified_triangle_maximum_reprojection_error_px": 2.0,
