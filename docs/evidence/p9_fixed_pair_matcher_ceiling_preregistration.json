      "direct_forward": "matcher({image0:{keypoints,descriptors,image_size},image1:{keypoints,descriptors,image_size}})",
      "accepted_raw_rows": "compact_matches_after_LighterGlue_internal_filter_threshold_0.1"
    },
    "maximum_symmetric_epipolar_error_px": 2.0,
    "symmetric_epipolar_definition": {
      "physical_xy": "native_xy+0.5",
      "relative_pose": "R_10=R_1*transpose(R_0);t_10=t_1-R_10*t_0",
      "fundamental": "F=inv(K_1)^T*[t_10]_x*R_10*inv(K_0)",
      "left_distance_px": "abs(x_1^T*F*x_0)/max(norm((F^T*x_1)[0:2]),1e-12)",
      "right_distance_px": "abs(x_1^T*F*x_0)/max(norm((F*x_0)[0:2]),1e-12)",
      "symmetric_error_px": "max(left_distance_px,right_distance_px)",
      "acceptance": "finite_symmetric_error_px<=2.0_inclusive"
    },
    "common_confidence": "sqrt(left_detector_score*right_detector_score)",
    "minimum_common_confidence": 0.0,
    "atomic_fresh_output_required": true,
    "partial_or_spliced_arm_output_allowed": false
  },
