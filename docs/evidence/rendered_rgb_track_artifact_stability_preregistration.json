  "artifact_detector": {
    "source": "gsplat_2dgs_rendered_distortion",
    "render_mode": "RGB; alpha and distortion are returned as independent 2DGS buffers; rendered depth is not consumed",
    "risk": "clamp(nonnegative_distortion / q95(nonnegative_distortion where alpha>=0.05), 0, 1)",
    "empty_or_zero_supported_distortion": "all_zero_risk",
    "gaussian_risk_transfer": "nearest_native_grid_sample_at_visible_projected_gaussian_centres",
    "opacity_multiplier": "1 - 0.5 * gaussian_risk",
    "opacity_suppression_strength": 0.5,
    "risk_reference_quantile": 0.95,
    "alpha_minimum": 0.05
  },
  "observation_stability": {
    "descriptors": "SuperPoint raw and clean descriptors sampled at the exact frozen raw keypoint rows",
    "descriptor_term": "clamp(cosine(raw,clean),0,1)",
    "detector_term": "symmetric min/max ratio between frozen raw score and highest clean two-pass-NMS score within 4px",
    "position_term": "exp(-0.5 * clean_peak_displacement_px^2 / 2.0^2)",
    "artifact_term": "1 - risk_at_frozen_keypoint",
    "artifact_reliability": "geometric_mean(descriptor,detector,position,artifact)",
    "combined_reliability": "v14_appearance_reliability * artifact_reliability",
    "clean_peak_search_radius_px": 4,
    "position_sigma_px": 2.0,
    "superpoint_nms_radius": 4,
    "descriptor_trim_fraction": 0.2
  },
